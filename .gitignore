# Python / numba caches
__pycache__/
*.pyc
*.nbc
*.nbi

# run logs (progress spam, not results)
*.log

# Results and figures are contingent/regenerated (rerun on AWS) and NOT committed -- only the
# folders are tracked (via .gitkeep). Covers .npz, job checkpoints, run logs, rendered figures.
paper_results/npz/*
paper_results/figures/*
!paper_results/npz/.gitkeep
!paper_results/figures/.gitkeep

# editor/agent local config
.claude/

_df_private/
